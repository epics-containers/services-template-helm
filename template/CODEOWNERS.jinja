# Generated once by services-template-helm (copier _skip_if_exists): this
# repo owns it after that -- 'copier update' never rewrites it again.
#
{% if git_platform == 'github.com' -%}
# GitHub has no sections: a path's owners are whoever the *last* matching
# line in this file names, not every line that matches. The '# [Controls]',
# '# [Data Acquisition]' and '# [Tech UI]' lines below are comments --
# GitHub ignores them -- kept only so ci_verify_team.py and
# update_checklist.sh can still read this file as one team's-paths map per
# comment. A path matched by more than one team's glob (for example the
# synoptic chart, matched by both the Controls IOC glob and Tech UI) needs
# one explicit line naming every team that owns it, placed after the
# broader globs so it is the line that wins. A path outside every glob
# needs no code-owner approval: there is no '*' default-owner line. Owners
# must be GitHub users or org teams with write access to this repository.
#
# Add each team's reviewers on its path lines, e.g.
# '/services/{{ location }}-*/ @my-org/controls' -- not after the comment
# heading, which GitHub ignores. A service that follows no naming
# convention (e.g. a hand-added one-off) must be added under its team's
# comment heading by hand, with owners on that new path line:
# ci_verify_team.py <team> warns about any service claimed by no section.
# ci_verify_team.py and update_checklist.sh read these comment headings to
# work out which services a team owns, independently of whether owners are
# set on them.
{% else -%}
# GitLab evaluates each section independently, so a path matched by more
# than one section (for example the synoptic chart, claimed by both the
# [Controls] IOC glob and [Tech UI]) is fine -- it just needs review from
# every team that claims it. A path outside every section needs no
# code-owner approval: there is no '*' default-owner line. GitLab 17.11+
# supports a leading '!' to exclude a path from a section; this file does
# not use it, and update_checklist.sh (unlike ci_verify_team.py) does not
# understand it -- see that script's header.
#
# Add each team's reviewers after the section name or after a path, e.g.
# '[Controls] @my-group/controls'. A service that follows no naming
# convention (e.g. a hand-added one-off) must be added to its team's section
# by hand: ci_verify_team.py <team> warns about any service claimed by no
# section. ci_verify_team.py and update_checklist.sh read these sections to
# work out which services a team owns, independently of whether owners are
# set on them.
{% endif %}
{% set hdr = "# " if git_platform == 'github.com' else "" -%}
{{ hdr }}[Controls]
/services/{{ location }}-*/
/services/values.yaml
/.helm-shared/
{% if gateway -%}
/services/{{ domain }}-epics-gateways/
{% endif -%}
/services/{{ domain }}-epics-opis/
/services/{{ domain }}-epics-pvcs/
{% if instrument_configs %}
{{ hdr }}[Data Acquisition]
{% for inst in instrument_configs -%}
{% for service in ["blueapi", "nexus", "rabbitmq"] if inst[service] -%}
/services/{{ inst.name }}-{{ service }}/
{% endfor -%}
{% endfor -%}
{% endif %}
{{ hdr }}[Tech UI]
/services/{{ location }}-synoptic/
/synoptic/
{% if git_platform == 'github.com' -%}

# claimed by both Controls (the broader '/services/{{ location }}-*/' glob
# above) and Tech UI: an explicit line after every broader glob, naming
# both teams' owners, so this is the line that wins.
/services/{{ location }}-synoptic/
{% endif -%}
