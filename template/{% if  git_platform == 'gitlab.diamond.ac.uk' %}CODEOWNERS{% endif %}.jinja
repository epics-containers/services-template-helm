# Generated once by services-template-helm (copier _skip_if_exists): this
# repo owns it after that -- 'copier update' never rewrites it again.
#
# GitLab evaluates each section independently, so a path matched by more
# than one section (for example the synoptic chart, claimed by both the
# [Controls] IOC glob and [Tech UI]) is fine -- it just needs review from
# every team that claims it. A path outside every section needs no
# code-owner approval: there is no '*' default-owner line. GitLab 17.11+
# supports a leading '!' to exclude a path from a section; this file does
# not use it, and update_checklist.sh (unlike ci_verify_team.py) does not
# understand it -- see that script's header.
#
# Add each team's reviewers after the section name or after a path, e.g.
# '[Controls] @my-group/controls'. A service that follows no naming
# convention (e.g. a hand-added one-off) must be added to its team's section
# by hand: ci_verify_team.py <team> warns about any service claimed by no
# section. ci_verify_team.py and update_checklist.sh read these sections to
# work out which services a team owns, independently of whether owners are
# set on them.

[Controls]
/services/{{ location }}-*/
/services/values.yaml
/.helm-shared/
{% if gateway -%}
/services/{{ domain }}-epics-gateways/
{% endif -%}
/services/{{ domain }}-epics-opis/
/services/{{ domain }}-epics-pvcs/
{% if athena_services %}
[Data Acquisition]
{% if "blueapi" in athena_services -%}
/services/{{ instrument }}-blueapi/
{% endif -%}
{% if "nexus" in athena_services -%}
/services/{{ instrument }}-nexus/
{% endif -%}
{% if "rabbitmq" in athena_services -%}
/services/{{ instrument }}-rabbitmq/
{% endif -%}
{% endif %}
[Tech UI]
/services/{{ location }}-synoptic/
/synoptic/
