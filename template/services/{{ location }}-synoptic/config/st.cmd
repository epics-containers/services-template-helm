# basic IOC startup script to load the synoptic status PVs
cd "/epics/ioc"

epicsEnvSet EPICS_TZ GMT0BST

dbLoadDatabase dbd/ioc.dbd
ioc_registerRecordDeviceDriver pdbbase

# <prefix>:STA records for each techui.yaml component, generated by the
# generate-synoptic-extras init container (techui-builder status)
dbLoadRecords /epics/opi/status.db
iocInit
